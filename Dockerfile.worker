# Worker 24/7 do agent-engine (fusão Vendaval) — processo long-running fora do Next.
# Roda TS direto via tsx (sem build): o worker é I/O-bound e o cold start não importa.
# ponytail: imagem single-stage com devDeps (tsx precisa); multi-stage + prune é Fase 4.
FROM node:22-alpine

WORKDIR /app
# pnpm fixado na versão do lockfile do repo (pnpm 10 bloquearia build scripts).
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Healthz do worker (bind 0.0.0.0 dentro do container).
EXPOSE 8787

# --conditions=react-server: o worker importa `lib/supabase/admin.ts`, que tem
# `import "server-only"` como guarda contra uso em componente de cliente. Sob
# `tsx` (Node puro) esse pacote resolve para o `index.js`, que LANÇA — e o
# worker morre no boot, em loop. A condição `react-server` faz o mesmo pacote
# resolver para o `empty.js`, que é no-op. A guarda continua valendo onde ela
# de fato serve: no build do Next, que é quem sabe o que é componente cliente.
CMD ["pnpm", "exec", "tsx", "--conditions=react-server", "workers/agent-worker/main.ts"]
